# Optional overrides. The defaults work when the service is started from ml-service/.
PKL_DATA_DIR=../dataset
ML_ARTIFACTS_DIR=./artifacts

# Comma-separated browser origins allowed to call the service directly.
ML_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: require this value in the x-train-token header for POST /train.
# Leave empty to allow local retraining without a token.
ML_TRAIN_TOKEN=
